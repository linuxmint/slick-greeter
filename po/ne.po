msgid "Log In"
msgstr "लग् इन गर्ने"

#: src/user-list.vala:845
#, c-format
msgid "Login as %s"
msgstr "%sको रूपमा लग् इन गर्नुहोस्"

#: src/user-list.vala:849
msgid "Retry"
msgstr "पुन: प्रयास गर्नुहोस्"

#: src/user-list.vala:850
#, c-format
msgid "Retry as %s"
msgstr "%sको रूपमा पुन: प्रयास गर्नुहोस्"

