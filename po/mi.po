#: src/greeter-list.vala:303
#, c-format
msgid "Enter password for %s"
msgstr "Tāuru kupuhipa mō %s"

#: src/greeter-list.vala:305
msgid "Enter your username"
msgstr "Tāuru tō ingoa kaiwhakamahi"

#: src/greeter-list.vala:815 src/user-list.vala:720
msgid "Password:"
msgstr "Kupuhipa:"

#: src/greeter-list.vala:817 src/user-list.vala:714
msgid "Username:"
msgstr "Ingoa kaiwhakamahi:"

#: src/greeter-list.vala:872
msgid "Invalid password, please try again"
msgstr "Hē te kupuhipa, anō"

#: src/greeter-list.vala:883
msgid "Failed to authenticate"
msgstr "I rahua te takiuru"

#: src/greeter-list.vala:929
msgid "Failed to start session"
msgstr "I rahua te tīmata wātū"

#: src/greeter-list.vala:943
msgid "Logging in..."
msgstr "E takiuru ana..."

#: src/main-window.vala:52
msgid "Login Screen"
msgstr "Mata Takiuru"

#: src/main-window.vala:113
msgid "Back"
msgstr "Hoki"

#: src/menubar.vala:324
msgid "Power:"
msgstr "Hiko:"

#: src/menubar.vala:374
msgid "Accessibility"
msgstr "Urutau"

#: src/menubar.vala:383
msgid "Onscreen keyboard"
msgstr "Papapātuhi mata"

#: src/menubar.vala:388
msgid "High Contrast"
msgstr "Tino rerekē"

#: src/menubar.vala:394
msgid "Screen Reader"
msgstr "Kaitiro mata"

#: src/menubar.vala:406 src/menubar.vala:453
msgid "Quit..."
msgstr "Kati..."

#: src/menubar.vala:419 src/shutdown-dialog.vala:155
msgid "Suspend"
msgstr "Whakatā"

#: src/menubar.vala:437 src/shutdown-dialog.vala:172
msgid "Hibernate"
msgstr "Moe roa"

#: src/menubar.vala:476 src/menubar.vala:520 src/menubar.vala:544
msgid "Keyboard layout:"
msgstr "Whakatakotoranga papapātuhi:"

#: src/menubar.vala:532
msgid "More layouts..."
msgstr "Ētahi atu whakatakotoranga..."

#: src/prompt-box.vala:215
msgid "Session Options"
msgstr "Kōwhiringa wātū"

#: src/session-list.vala:34
msgid "Select desktop environment"
msgstr "Tīpako taiao papamahi"

#: src/shutdown-dialog.vala:101
msgid "Goodbye. Would you like to..."
msgstr "E noho rā. Kei te hiahia koe ki te..."

#: src/shutdown-dialog.vala:105 src/shutdown-dialog.vala:207
msgid "Shut Down"
msgstr "Whakaweto"

#: src/shutdown-dialog.vala:112
msgid "Are you sure you want to shut down the computer?"
msgstr "Kei te tino hiahia koe ki te whakaweto i te rorohiko?"

#: src/shutdown-dialog.vala:137
msgid ""
"Other users are currently logged in to this computer, shutting down now will "
"also close these other sessions."
msgstr ""
"Kei te takiuru ētahi atu kaiwhakamahi ki tēnei rorohiko. Mā te whakaweto "
"ināianei ka kati hoki ēnei wātū."

#: src/shutdown-dialog.vala:190
msgid "Restart"
msgstr "Tīmata Anō"

#: src/slick-greeter.vala:749
msgid "Show release version"
msgstr "Tiro putanga tuku"

#: src/slick-greeter.vala:752
msgid "Run in test mode"
msgstr "Whakahaere ki te aratau whakamātau"

#: src/slick-greeter.vala:768
#, c-format
msgid "Run '%s --help' to see a full list of available command line options."
msgstr ""
"Whakahaere '%s --help' kia tiro i te rārangi katoa o ngā kōwhiringa rārangi "
"whakahau e wātea ana."

#: src/toggle-box.vala:109
#, c-format
msgid "%s (Default)"
msgstr "%s (Taunoa)"

#: src/user-list.vala:45
msgid "Guest Session"
msgstr "Wātū manuhiri"

#: src/user-list.vala:455
msgid "Please enter a complete e-mail address"
msgstr "Tāuru īmēra katoa"

#: src/user-list.vala:535
msgid "Incorrect e-mail address or password"
msgstr "Hē te īmēra, te kupuhipa rānei"

#: src/user-list.vala:566
msgid ""
"If you have an account on an RDP or Citrix server, Remote Login lets you run "
"applications from that server."
msgstr ""
"Mēnā he pūkete āu ki tētahi tūmau RDP, Citrix rānei, mā te Takiuru Tauwāhi e "
"whakahaere taupānga mai i taua tūmau."

#: src/user-list.vala:568
msgid ""
"If you have an account on an RDP server, Remote Login lets you run "
"applications from that server."
msgstr ""
"Mēnā he pūkete āu ki tētahi tūmau RDP, mā te Takiuru Tauwāhi e whakahaere "
"taupānga mai i taua tūmau."

#: src/user-list.vala:571
msgid "Cancel"
msgstr "Whakakore"

#: src/user-list.vala:572
msgid "Set Up..."
msgstr "Whakarite..."

#: src/user-list.vala:574
msgid ""
"You need an Ubuntu Remote Login account to use this service. Would you like "
"to set up an account now?"
msgstr ""
"Me whai pūkete Takiuru Tauwāhi Ubuntu koe hei whakamahi i tēnei ratonga. Kei "
"te hiahia koe ki te whakarite pūkete ināianei?"

#: src/user-list.vala:578
msgid "OK"
msgstr "Pai"

#: src/user-list.vala:579
msgid ""
"You need an Ubuntu Remote Login account to use this service. Visit "
"uccs.canonical.com to set up an account."
msgstr ""
"Me whai pūkete Takiuru Tauwāhi Ubuntu koe hei whakamahi i tēnei ratonga. "
"Tirohia uccs.canonical.com hei whakarite pūkete."

#: src/user-list.vala:698
msgid "Server type not supported."
msgstr "Kāore tēnei momo tūmau i te tautokona."

#: src/user-list.vala:739
msgid "Domain:"
msgstr "Rohe:"

#: src/user-list.vala:800
msgid "Email address:"
msgstr "Īmēra:"

#: src/user-list.vala:844
msgid "Log In"
msgstr "Takiuru"

#: src/user-list.vala:845
#, c-format
msgid "Login as %s"
msgstr "Takiuru hei %s"

#: src/user-list.vala:849
msgid "Retry"
msgstr "Anō"

#: src/user-list.vala:850
#, c-format
msgid "Retry as %s"
msgstr "Anō hei %s"

#: src/user-list.vala:892
msgid "Login"
msgstr "Takiuru"
