msgid "Log In"
msgstr "Logga in"

#: src/user-list.vala:845
#, c-format
msgid "Login as %s"
msgstr "Logga in som %s"

#: src/user-list.vala:849
msgid "Retry"
msgstr "Försök igen"

#: src/user-list.vala:850
#, c-format
